{
  "name": "partnertax-automat",
  "version": "1.0.19",
  "description": "Lokalny automat do pobierania raportow z Uber/Bolt/Freenow i wgrywania ich do PartnerTax admin",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "playwright install chromium",
    "test": "playwright test",
    "build:mac": "electron-builder --mac",
    "build:mac-intel": "electron-builder --mac --x64",
    "install:mac": "npm run build:mac && rm -rf \"/Applications/PartnerTax Automat.app\" && cp -R \"$(find dist -maxdepth 2 -name '*.app' | head -1)\" /Applications/ && echo 'Zainstalowano w /Applications'",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "release:win": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac --publish always",
    "release:mac-all": "electron-builder --mac --arm64 --x64 --publish always",
    "release:linux": "electron-builder --linux --publish always",
    "setup:mac-signing": "./scripts/setup-mac-signing.sh"
  },
  "author": "PartnerTax",
  "license": "UNLICENSED",
  "dependencies": {
    "archiver": "^7.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "build": {
    "appId": "pl.partnertax.automat",
    "productName": "PartnerTax Automat",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "CorsairHS",
      "repo": "automat-releases",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "icon": "build/icon.png",
    "afterSign": "scripts/mac-after-sign.js"
  }
}
